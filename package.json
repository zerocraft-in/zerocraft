{
  "name": "zerocraft",
  "version": "0.0.34",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/cms",
    "apps/store",
    "apps/studio",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:store": "turbo run dev --filter=@zerocraft/store",
    "dev:cms": "turbo run dev --filter=@zerocraft/cms",
    "dev:studio": "turbo run dev --filter=@zerocraft/studio",
    "build": "turbo run build --concurrency=1",
    "build:store": "turbo run build --concurrency=1 --filter=@zerocraft/store",
    "build:cms": "turbo run build --concurrency=1 --filter=@zerocraft/cms",
    "build:studio": "turbo run build --concurrency=1 --filter=@zerocraft/studio",
    "build:cms:release": "node scripts/release/build-cms.mjs",
    "typecheck": "turbo run typecheck --concurrency=1",
    "lint": "eslint .",
    "lint:cms": "eslint apps/cms --no-cache",
    "verify": "npm run verify:seed",
    "verify:commerce": "node scripts/verify-commerce-schema.mjs",
    "verify:commerce-correctness": "node --experimental-strip-types scripts/verify-commerce-correctness.mjs",
    "verify:cart-correctness": "node --experimental-strip-types --experimental-loader ./scripts/ts-loader.mjs scripts/verify-cart-correctness.mjs",
    "verify:checkout-correctness": "node --experimental-strip-types --experimental-loader ./scripts/ts-loader.mjs scripts/verify-checkout-correctness.mjs",
    "verify:transactional-checkout": "node scripts/verify-transactional-checkout.mjs",
    "test:security": "npm run test:rbac && npm run test:gmail-workspace",
    "test:rbac": "node scripts/security/rbac-static-tests.mjs",
    "test:gmail-workspace": "node scripts/security/gmail-workspace-static-tests.mjs && node --experimental-loader ./scripts/security/server-only-test-loader.mjs --experimental-strip-types scripts/security/gmail-workspace-unit-tests.mjs",
    "verify:release": "node scripts/release/check-migrations.mjs && npm run test:rbac && npm run test:gmail-workspace && npm run test:cms-routes && npm run typecheck --workspace=@zerocraft/cms",
    "verify:env-contract": "node scripts/release/check-env-contract.mjs",
    "test:cms-routes": "node scripts/release/check-cms-routes.mjs",
    "smoke:cms": "node scripts/release/smoke-cms.mjs",
    "smoke:cms:build": "node scripts/release/smoke-cms-build.mjs",
    "smoke:public": "node scripts/release/smoke-public.mjs",
    "verify:seed": "node scripts/verify-seed-commerce.mjs",
    "seed": "npm run seed:commerce",
    "seed:commerce": "node scripts/seed-commerce.mjs",
    "seed:tamil-posters": "node --env-file=.env.local scripts/seed-tamil-poster-products.mjs",
    "seed:apparel": "node --env-file=.env.local scripts/replace-demo-with-apparel.mjs",
    "seed:storefront-bundles": "node --env-file=.env.local scripts/seed-storefront-bundles.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@tabler/icons": "^3.36.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-table": "^9.3.1",
    "@types/three": "^0.185.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.8.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.30.0",
    "motion": "^12.9.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.25",
    "react": "^19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sass": "^1.87.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
