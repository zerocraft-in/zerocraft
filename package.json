{
  "name": "zerocraft",
  "version": "0.2.0",
  "private": true,
  "description": "Zerocraft Platform - Digital Services, Coding, Design, Printing and Business Management Platform",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.18.3"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @zerocraft/admin --filter @zerocraft/accounts dev",
    "dev:admin": "pnpm --filter @zerocraft/admin dev",
    "dev:accounts": "pnpm --filter @zerocraft/accounts dev",
    "build": "pnpm --filter @zerocraft/admin build",
    "build:admin": "pnpm --filter @zerocraft/admin build",
    "build:accounts": "pnpm --filter @zerocraft/accounts build",
    "start": "pnpm --filter @zerocraft/admin start",
    "lint": "pnpm --filter @zerocraft/admin lint",
    "lint:admin": "pnpm --filter @zerocraft/admin lint",
    "lint:accounts": "pnpm --filter @zerocraft/accounts lint",
    "typecheck": "pnpm --filter @zerocraft/admin typecheck",
    "typecheck:admin": "pnpm --filter @zerocraft/admin typecheck",
    "typecheck:accounts": "pnpm --filter @zerocraft/accounts typecheck",
    "test": "pnpm --filter @zerocraft/admin test",
    "test:admin": "pnpm --filter @zerocraft/admin test",
    "test:accounts": "pnpm --filter @zerocraft/accounts test",
    "test:e2e": "pnpm --filter @zerocraft/admin test:e2e",
    "db:migration-check": "node tooling/scripts/validate-migrations.js && node tooling/scripts/check-duplicate-timestamps.js",
    "db:verify-schema": "echo 'Use Supabase dashboard SQL Editor to run read-only verification queries'",
    "db:start": "cd infrastructure/supabase && supabase start",
    "db:stop": "cd infrastructure/supabase && supabase stop",
    "db:reset": "cd infrastructure/supabase && supabase db reset",
    "db:push": "cd infrastructure/supabase && supabase db push",
    "db:diff": "cd infrastructure/supabase && supabase db diff",
    "clean": "pnpm -r exec rimraf .next dist .turbo"
  },
  "devDependencies": {
    "supabase": "3.1.0"
  }
}
