# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
**/.next/
**/.next-local/
**/.next-release/
/out/

# turborepo
**/.turbo/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Local-only Storage runtime test manifests and results
/.storage-runtime-test/
/.seed-preflight/

# Local Supabase runtime state and visual QA artifacts
/supabase/.temp/
/packages/supabase/supabase/supabase/.temp/
/tmp/
/apps/cms/ref/

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel
