

NEXT_PUBLIC_SUPABASE_URL=https://qvjhwxriafgobxknpqtq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# Server-only secret key. Used by trusted server code only.
# NEVER prefix with NEXT_PUBLIC_, never commit it, never place it in this file.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Canonical site URL used to build invite and password-reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Distributed API rate limiting (required in hosted multi-instance environments)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared taxonomy API (Cloudflare Worker)
NEXT_PUBLIC_TAXONOMY_API_URL=https://maara-taxonomy.store-maara.workers.dev

# ---------------------------------------------------------------------------
# Zerocraft tenant provisioning (LOCAL PLACEHOLDERS ONLY - never commit real values)
# ---------------------------------------------------------------------------
# Supabase OAuth (customer-owned account authorization). Register a Zerocraft
# OAuth app in Supabase and set the redirect URI to
#   http://localhost:8787/oauth/supabase/callback
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=http://localhost:8787/oauth/supabase/callback

# Supabase OAuth authorization/token endpoints (verify against official docs
# before production use; see docs/architecture/supabase-oauth.md).
SUPABASE_OAUTH_AUTHORIZE_URL=
SUPABASE_OAUTH_TOKEN_URL=
SUPABASE_OAUTH_API_BASE_URL=

# Symmetric key (base64, 32 bytes) used to encrypt OAuth tokens and tenant
# database credentials at rest. Generate with:
#   openssl rand -base64 32
TENANT_SECRET_ENCRYPTION_KEY=

# Platform DB connection for the provisioning Worker (server-only).
PLATFORM_SUPABASE_URL=
PLATFORM_SUPABASE_SECRET_KEY=

# Provisioning Worker shared secret for Next.js -> Worker calls.
TENANT_PROVISIONER_SHARED_SECRET=

# Public base URL of the provisioning Worker.
NEXT_PUBLIC_TENANT_PROVISIONER_URL=http://localhost:8787

# Optional allow-list of Supabase regions offered in the wizard.
TENANT_ALLOWED_REGIONS=ap-south-1,ap-southeast-1,eu-central-1,us-east-1

