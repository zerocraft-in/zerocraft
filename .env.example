# Use the credentials for the same Supabase project where admin-mvp.sql is applied.
NEXT_PUBLIC_SUPABASE_URL=https://jamyqssytdzbiiahtmsq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_-9gtyTERobgc00bkJ_nlrw_cJtldYRW
SUPABASE_SERVICE_ROLE_KEY=
ZEROCRAFT_TRANSACTIONAL_CHECKOUT_ENABLED=false
ZEROCRAFT_CUSTOMIZATION_REGISTRATION_ENABLED=false
ZEROCRAFT_MANUAL_PAYMENTS_ENABLED=false

# Canonical public URL for SEO, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://zerocraft.in

# Hostname routing. Set these to local equivalents when testing separate hosts.
NEXT_PUBLIC_STUDIO_URL=https://zerocraft.in
NEXT_PUBLIC_STORE_URL=https://store.zerocraft.in
NEXT_PUBLIC_ADMIN_URL=https://admin.zerocraft.in
ZEROCRAFT_HOSTNAME_ROUTING_ENABLED=true
NEXT_PUBLIC_X_URL=https://x.com/zerocraft_in

# Optional editorial assistant. Keep the key server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional encrypted Settings vault for Gemini and connected provider credentials.
# Generate a fresh 32-byte base64url value; keep it in server-only deployment secrets.
COMMERCE_CREDENTIALS_ENCRYPTION_KEY=

# Gmail API OAuth. Server-side only; register the exact redirect URI in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://admin.zerocraft.in/api/admin/email/oauth/callback

# Optional appointment notification automation. Server-side HTTPS webhook only.
N8N_WHATSAPP_WEBHOOK_URL=

# Studio event queue (order + appointment notifications). HTTPS endpoint.
STUDIO_AUTOMATION_WEBHOOK_URL=
# Optional store newsletter automation webhook. Leave empty until the provider is ready.
NEWSLETTER_WEBHOOK_URL=
# Long random secret used by your external scheduler as Authorization: Bearer <secret>.
CRON_SECRET=

# Server-side SMTP email delivery for CMS notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Studio integration health configuration. Keep provider secrets server-only.
GA4_PROPERTY_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://zerocraft.in/
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=https://admin.zerocraft.in/api/admin/search-console/oauth/callback
INSTAGRAM_ACCESS_TOKEN=
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=

# Multi-store: public registry JSON; see docs/cms/multi-store-setup.md.
NEXT_PUBLIC_STORE_CONNECTIONS=
# Server-only map keyed by store ID. Never use a NEXT_PUBLIC_ prefix.
STORE_SERVER_SECRETS=

STUDIO_CREDENTIALS_ENCRYPTION_KEY=
