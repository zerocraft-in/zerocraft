# Zerocraft Platform - Tenant Provisioner Worker (Local)
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and must never be committed.

# Platform database connection (local Supabase)
# The worker connects directly to PostgreSQL using the service role key
# to claim jobs, create tenant databases, and apply migrations.
SUPABASE_PLATFORM_URL=http://127.0.0.1:54322
SUPABASE_PLATFORM_SERVICE_ROLE_KEY=your-local-service-role-key

# Worker identification (unique per worker instance)
WORKER_ID=tenant-provisioner-local-1

# Provider selection: disabled | mock | managed
# The worker defaults to disabled. Mock is test-only and requires allowMock.
# Managed mode requires every TENANT_PROVISIONING_* value below.
TENANT_PROVISIONER_PROVIDER_MODE=disabled
TENANT_PROVISIONER_ALLOW_MOCK=false

# Managed provider (Supabase Management API)
# Use a platform-owned Supabase organization. Never point this at a customer
# project or at a protected project reference.
SUPABASE_MANAGEMENT_ACCESS_TOKEN=
TENANT_PROVISIONING_ORGANIZATION_ID=
TENANT_PROVISIONING_ORGANIZATION_SLUG=
TENANT_PROVISIONING_REGION=ap-south-1
TENANT_PROVISIONING_COMPUTE_SIZE=micro
TENANT_MANAGEMENT_API_BASE_URL=https://api.supabase.com
TENANT_MANAGEMENT_REQUEST_TIMEOUT_MS=15000
TENANT_MANAGEMENT_MAX_RETRIES=2
TENANT_MANAGEMENT_RETRY_BASE_DELAY_MS=250
TENANT_MANAGEMENT_RETRY_MAX_DELAY_MS=5000
TENANT_PROVISIONING_READINESS_TIMEOUT_MS=600000
TENANT_PROVISIONING_READINESS_POLL_INTERVAL_MS=5000
TENANT_ALLOWED_REGIONS=ap-south-1
TENANT_PROTECTED_PROJECT_REFS=ftcvyhlzeyqceosdqyxn,qvjhwxriafgobxknpqtq

# Tenant secret store. Only secret references are written to the platform DB.
# Multi-key rotation format (recommended):
#   TENANT_SECRETS_ACTIVE_KEY_ID=key-1
#   TENANT_SECRETS_LEGACY_KEY_ID=key-0
#   TENANT_SECRETS_KEY_key-1=<base64-32-byte-key>
#   TENANT_SECRETS_KEY_key-0=<base64-32-byte-key>
#
# Backward-compatible single-key format (treated as legacy key "legacy"):
TENANT_SECRETS_DIR=
TENANT_SECRETS_ENCRYPTION_KEY=

# Polling configuration
TENANT_PROVISIONER_POLL_INTERVAL_MS=5000
TENANT_PROVISIONER_MAX_POLLS=12

# Logging
LOG_LEVEL=info

# Tenant database credentials (used when creating tenant databases)
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=54322
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=postgres
TENANT_DB_NAME=postgres
