# Zerocraft Accounts — environment variables
# Copy to .env.local. Never commit real values.

# Public application origins (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# Optional destinations. Keep empty until the application exists and access
# rules are enforced. The gateway renders these as unavailable instead of
# linking to a non-existent product.
NEXT_PUBLIC_PARTNERS_URL=
NEXT_PUBLIC_COMMUNITY_URL=

# Platform Supabase project (Zerocraft-owned). Never create a project per customer.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
SUPABASE_SECRET_KEY=your-local-secret-key

# Server only. Shared with the admin application. 32+ random bytes, base64.
# Generate with: openssl rand -base64 48
AUTH_HANDOFF_SECRET=

# Optional explicit callback override. Must be the accounts /callback URL.
AUTH_CALLBACK_URL=http://localhost:3001/callback

# Only set to true after the provider is enabled in Supabase Auth AND the
# provider credentials are configured. False hides the button entirely.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false

# Passkeys are not rendered because no WebAuthn implementation is deployed.
# Do not flip this flag without a real passkey implementation.
NEXT_PUBLIC_AUTH_PASSKEY_ENABLED=false

