{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@zerocraft/supabase/*": [
        "../../packages/supabase/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../types/**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-local/types/**/*.ts",
    ".next-local/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "components/auth",
    "components/store",
    "components/studio",
    "components/settings-modal.tsx",
    "components/theme-toggle.tsx",
    "components/zeropop-effects.tsx",
    "components/zeropop-shop.tsx",
    "components/zeropop-store-page.tsx",
    "components/providers/auth-provider.tsx",
    "components/providers/provider.tsx",
    "components/currency-switcher-combobox.tsx"
  ]
}
