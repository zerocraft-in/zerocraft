# Studio platform project (the client store uses a separate Supabase project).
NEXT_PUBLIC_SUPABASE_URL=https://your-studio-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-studio-publishable-key

# Required for Studio Media uploads. Keep both keys server-side; never add NEXT_PUBLIC_.
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=zerocraft-media
# Optional custom/public R2 domain, without a trailing slash. Required to display uploaded assets publicly.
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://media.zerocraft.in

# OAuth connections are optional. Keep these server-only; never expose them with NEXT_PUBLIC_.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
META_OAUTH_CLIENT_ID=your-meta-app-id
META_OAUTH_CLIENT_SECRET=your-meta-app-secret
STUDIO_OAUTH_REDIRECT_URL=http://localhost:3003/api/studio/integrations/callback
STUDIO_OAUTH_ENCRYPTION_KEY=generate-a-32-byte-secret-key
