# Required for Studio sign-in and database access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Required for Studio Media uploads. Keep both keys server-side; never add NEXT_PUBLIC_.
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=zerocraft-media
# Optional custom/public R2 domain, without a trailing slash. Required to display uploaded assets publicly.
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://media.zerocraft.in
