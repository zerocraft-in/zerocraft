NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_X_URL=https://x.com/zerocraft_in
WEEKLY_REPORT_WORKER_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-the-same-worker-secret
COMMERCE_CREDENTIALS_ENCRYPTION_KEY=

# Gmail API OAuth. Register this exact redirect URI in a Google OAuth Web client.
# The OAuth consent screen must be approved for the Gmail scope before production use.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3002/api/admin/email/oauth/callback

# Free SMTP email delivery through Gmail or another SMTP provider.
# For Gmail, use an App Password or OAuth; never use the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=in.zerocraft@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=in.zerocraft@gmail.com
EMAIL_REPLY_TO=ivd.maran@gmail.com

# Studio integration health configuration. Keep provider secrets server-only.
GA4_PROPERTY_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://zerocraft.in/
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://localhost:3002/api/admin/search-console/oauth/callback
GOOGLE_ANALYTICS_REDIRECT_URI=http://localhost:3002/api/admin/analytics/oauth/callback
INSTAGRAM_ACCESS_TOKEN=
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=

# Optional server-side AI command routing for the Studio assistant.
# Keep this key server-only; do not prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cloudflare R2 server-side media storage. Keep both keys server-only.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=zerocraft-media
CLOUDFLARE_R2_PUBLIC_BASE_URL=
CLOUDFLARE_R2_MEDIA_PREFIX=assets

# Compatibility alias for older Supabase projects. Prefer PUBLISHABLE_KEY above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Multi-store: public registry JSON; see docs/cms/MULTI_STORE_SETUP.md.
NEXT_PUBLIC_STORE_CONNECTIONS=
# Server-only map keyed by store ID. Never use a NEXT_PUBLIC_ prefix.
STORE_SERVER_SECRETS=
# Central owner account (separate from each store database).
NEXT_PUBLIC_PLATFORM_SUPABASE_URL=
NEXT_PUBLIC_PLATFORM_SUPABASE_PUBLISHABLE_KEY=
PLATFORM_SUPABASE_SERVICE_ROLE_KEY=
# Base64-encoded 32-byte key. Keep stable; losing it makes encrypted connections unreadable.
PLATFORM_ENCRYPTION_KEY=
PLATFORM_ORIGIN=http://localhost:3002
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
