# Gmail API OAuth. Register this exact redirect URI in a Google OAuth Web client.
# The OAuth consent screen must be approved for the Gmail scope before production use.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3002/api/studio/email/oauth/callback

# Free SMTP email delivery through Gmail or another SMTP provider.
# For Gmail, use an App Password or OAuth; never use the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=in.zerocraft@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=in.zerocraft@gmail.com
