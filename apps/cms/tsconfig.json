{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@zerocraft/supabase/*": [
        "../../packages/supabase/src/*"
      ],
      "@zerocraft/components/ui/*": [
        "../../packages/ui/src/components/*"
      ],
      "@zerocraft/hooks/*": [
        "../../packages/ui/src/hooks/*"
      ],
      "@zerocraft/lib/cn": [
        "../../packages/ui/src/cn.ts"
      ]
    },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../types/**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-local/types/**/*.ts",
    ".next-local/dev/types/**/*.ts",
    ".next-currency-local/types/**/*.ts",
    ".next-currency-local/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "components/sections"
  ]
}
