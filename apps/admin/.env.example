# Maara Merch - Admin environment variables
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and must never be committed.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET
# ---------------------------------------------------------------------------
# Central accounts (Zerocraft ID)
# ---------------------------------------------------------------------------
# Public origin of the accounts application. Login, signup, verification and
# password recovery happen there.
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# Server-only shared secret used to sign the server-to-server handoff
# redemption. Must match AUTH_HANDOFF_SECRET in apps/accounts.
# Generate with: openssl rand -base64 48
AUTH_HANDOFF_SECRET=

# Distributed API rate limiting (required in hosted multi-instance environments)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP (Gmail) - used only server-side for invitation emails
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Maara Merch

# Cloudflare R2 - private media storage
# Create an R2 bucket named `maara`, generate a bucket-scoped API token, and
# keep public bucket access disabled. Runtime reads use short-lived signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=maara
R2_CUSTOM_DOMAIN=

# Public media is served only by the reviewed Worker route, never directly by R2.
# Keep empty until cdn.maara.co.in is routed to the Worker.
PUBLIC_CDN_BASE_URL=https://cdn.maara.co.in

# Shared taxonomy API (Cloudflare Worker)
NEXT_PUBLIC_TAXONOMY_API_URL=https://taxonomy.maara.co.in

# ---------------------------------------------------------------------------
# Tenant provisioning Worker connection
# ---------------------------------------------------------------------------
# The admin authenticates to the Tenant Provisioning Worker with this shared
# secret. Must match TENANT_PROVISIONER_SHARED_SECRET on the Worker side.
# Generate with: openssl rand -base64 48
# Never expose this through NEXT_PUBLIC_* or client-side code.
TENANT_PROVISIONER_URL=http://localhost:8787
TENANT_PROVISIONER_SHARED_SECRET=
