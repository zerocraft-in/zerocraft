# Zerocraft Platform — local environment variables

# Copy this file to `.env` and fill in values. Never commit `.env`.

# Hosted Supabase project (no local Docker required)
SUPABASE_URL=https://YOUR_HOSTED_PROJECT.supabase.co

# Hosted Supabase publishable key (for client-side use)
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only secret key. Used by trusted server code only.
# NEVER prefix with NEXT_PUBLIC_, never commit it, never place it in this file.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Auth
SUPABASE_AUTH_SITE_URL=https://YOUR_SITE_URL.vercel.app

# Bootstrap access: run scripts/bootstrap-platform-owner.sql as the
# database owner (postgres superuser) or via the service_role key.
# No shared bootstrap secret is used; access is controlled by database
# role membership (postgres superuser or service_role).
