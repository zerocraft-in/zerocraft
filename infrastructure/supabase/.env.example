# Zerocraft Platform — local environment variables

# Copy this file to `.env` and fill in values. Never commit `.env`.

# Supabase local stack (set by `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Auth
SUPABASE_AUTH_SITE_URL=http://localhost:3000

# Bootstrap access: run scripts/bootstrap-platform-owner.sql as the
# database owner (postgres superuser) or via the service_role key.
# No shared bootstrap secret is used; access is controlled by database
# role membership (postgres superuser or service_role).
